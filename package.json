{
  "name": "rob-aoe-web",
  "version": "0.16.4-17.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json && node --experimental-strip-types scripts/copy-migrations.ts && npm --prefix web run build",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:web": "npm --prefix web run test",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "verze": "node --experimental-strip-types scripts/verze.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
