# Připojení k PostgreSQL. Bez tohohle server hned po startu spadne.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rob_aoe

# Veřejná adresa, na které web lidem běží. Musí přesně sedět s tím, kam se
# prohlížeč skutečně dívá — Steam přihlášení se po ověření vrací zpátky sem.
BASE_URL=http://localhost:3000

PORT=3000

# Bezplatný klíč z https://steamcommunity.com/dev/apikey. Bez něj se hráčům
# neukážou odehrané hodiny ve hře — zbytek webu funguje i tak.
STEAM_API_KEY=

# Steam ID (64bitové) Robova účtu. POVINNÉ: bez něj se server odmítne spustit.
# (Kdyby se spustil, přihlašovací routa by Robovi při každém přihlášení zapsala
# je_admin = false a panel režie by mu zmizel bez chybové hlášky.)
ADMIN_STEAM_ID=

# Úroveň serverového logu (fatal/error/warn/info/debug/trace). Výchozí info.
LOG_LEVEL=info
