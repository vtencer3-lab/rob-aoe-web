# Připojení k PostgreSQL. Bez tohohle server hned po startu spadne.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rob_aoe

# Veřejná adresa, na které web lidem běží. Musí přesně sedět s tím, kam se
# prohlížeč skutečně dívá — Steam přihlášení se po ověření vrací zpátky sem.
BASE_URL=http://localhost:3000

PORT=3000

# Na čem server poslouchá. Výchozí 127.0.0.1 — ven vede vždy tunel nebo proxy.
# V Docker kontejneru (jouki.cz) je to 0.0.0.0, jinak se k němu proxy nedostane.
HOST=127.0.0.1

# Bezplatný klíč z https://steamcommunity.com/dev/apikey. Bez něj se hráčům
# neukážou odehrané hodiny ve hře — zbytek webu funguje i tak.
STEAM_API_KEY=

# Steam ID (64bitové) účtů s režií, víc účtů oddělených čárkou (id1,id2).
# POVINNÉ, pokud nezapneš ADMIN_BOOTSTRAP níž:
# bez jednoho z těch dvou se server odmítne spustit. (Kdyby se spustil,
# přihlašovací routa by Robovi při každém přihlášení zapsala je_admin = false
# a panel režie by mu zmizel bez chybové hlášky.)
ADMIN_STEAM_ID=

# Pojistka pro případ, že ADMIN_STEAM_ID nemáš: adminem se stane PRVNÍ, kdo se
# přihlásí. Platí to jen dokud žádný admin neexistuje — každý další už práva
# nedostane a tomu prvnímu se neodeberou. Může proto zůstat zapnutá natrvalo;
# jakmile admin existuje, nedělá nic. Dokud neexistuje, platí, že kdo drží
# adresu, drží režii, takže se přihlas dřív, než adresu komukoliv pošleš.
# Vyplněné ADMIN_STEAM_ID má vždycky přednost a tuhle proměnnou přebije.
ADMIN_BOOTSTRAP=

# Úroveň serverového logu (fatal/error/warn/info/debug/trace). Výchozí info.
LOG_LEVEL=info

# Zkušební dveře pro vyzkoušení celého večera nasucho, bez čtyř skutečných
# Steam účtů: /api/dev/naplnit?pocet=3 nasype do akce falešné hráče a
# /api/dev/login?jmeno=Pepa se za jednoho z nich přihlásí. Steam se obchází,
# takže se to samo zavře, jakmile BASE_URL míří na https (tunel).
DEV_PRISTUP=false

# Tlačítka „+ Zkušební hráč“ / „Odebrat zkušební“ v panelu akce pro režii:
# přihlásí do akce vymyšlené hráče se statistikami, ať jde složit plná
# sestava bez skutečných lidí. Na rozdíl od DEV_PRISTUP se za ně nejde
# přihlásit, takže je to bezpečné i přes https — na ostré verzi ale nemá co dělat.
ZKUSEBNI_HRACI=false
